      <aliases enabled='yes' />
      <column caption='Average Delivery Minutes' datatype='integer' name='[AverageDeliveryMinutes]' role='measure' type='quantitative' />
      <column caption='AvgDeliveryFee EGP' datatype='real' name='[AvgDeliveryFee_EGP]' role='measure' type='quantitative' />
      <column caption='Base Delivery Minutes' datatype='integer' name='[BaseDeliveryMinutes]' role='measure' type='quantitative' />
      <column caption='KPI_TotalOrders' datatype='integer' name='[Calculation_0286148804481024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([OrderID])' />
      </column>
      <column caption='KPI_TotalRevenue' datatype='real' name='[Calculation_0286148805947393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalAmount_EGP])' />
      </column>
      <column caption='KPI_TotalCommission' datatype='real' name='[Calculation_0286148806471682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([PlatformCommissionAmount_EGP])' />
      </column>
      <column caption='KPI_NetProfit' datatype='real' name='[Calculation_0286148807024643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalAmount_EGP]) - SUM([PlatformCommissionAmount_EGP]) - SUM([CostAtTime_EGP]*[Quantity]) - COUNTD([OrderID]*12)' />
      </column>
      <column caption='COD_RefusalRate' datatype='real' name='[Calculation_0286148812308484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([WasCODRefused]=TRUE)) / SUM(INT([IsCOD]=TRUE)) * 100' />
      </column>
      <column caption='KPI_TotalCustomers' datatype='integer' name='[Calculation_0286149095870470]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CustomerID])' />
      </column>
      <column caption='KPI_AvgOrderValue' datatype='real' name='[Calculation_0286149096730631]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([TotalAmount_EGP])' />
      </column>
      <column caption='TotalOrdersPerCustomer' datatype='integer' name='[Calculation_0286149098692617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [CustomerID] : COUNTD([OrderID]) }' />
      </column>
      <column caption='CustomerTier' datatype='string' name='[Calculation_0286149099847690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0286149098692617] = 1 THEN &quot;One Time&quot;&#13;&#10;ELSEIF [Calculation_0286149098692617] &lt;= 5 THEN &quot;Repeat&quot;&#13;&#10;ELSE &quot;Loyal&quot;&#13;&#10;END' />
      </column>
      <column caption='KPI_RepeatCustomerRate' datatype='real' name='[Calculation_0286149100683275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [Calculation_0286149098692617] &gt; 1 THEN [CustomerID] END) / COUNTD([CustomerID]) * 100' />
      </column>
      <column caption='KPI_CODRefusalLoss' datatype='real' name='[Calculation_0286149102108684]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [WasCODRefused] = TRUE THEN [RefusedAmount_EGP] ELSE 0 END)' />
      </column>
      <column caption='KPI_TotalItemsTracked' datatype='integer' name='[Calculation_0286149147713549]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ItemID])' />
      </column>
      <column caption='KPI_AvgPriceGap' datatype='real' name='[Calculation_0286149148278798]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PriceDiff_Pct])' />
      </column>
      <column caption='KPI_VulnerableItems' datatype='integer' name='[Calculation_0286149148991503]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [PriceDiff_Pct] &lt; -10 THEN [ItemID] END)' />
      </column>
      <column caption='KPI_OpportunityItems' datatype='integer' name='[Calculation_0286149149847568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( IF [PriceDiff_Pct] &gt; 10 THEN [ItemID] END)' />
      </column>
      <column caption='PriceGapCategory' datatype='string' name='[Calculation_0286149153161233]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [PriceDiff_Pct] &lt; -10 THEN &quot;Vulnerable&quot;&#13;&#10;ELSEIF [PriceDiff_Pct] &gt; 10 THEN &quot;Opportunity&quot;&#13;&#10;ELSE &quot;Competitive&quot;&#13;&#10;END' />
      </column>
      <column caption='AvgGapByCompetitor' datatype='real' name='[Calculation_0286149156384786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PriceDiff_Pct])' />
      </column>
      <column caption='KPI_TotalCompetitors' datatype='integer' name='[Calculation_0286149177626643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([CompetitorID])' />
      </column>
      <column caption='KPI_AvgCompetitorRating' datatype='real' name='[Calculation_0286149177974804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([GoogleMapsRating])' />
      </column>
      <column caption='KPI_AvgCompetitorDelivery' datatype='real' name='[Calculation_0286149178511381]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([AverageDeliveryMinutes])' />
      </column>
      <column caption='KPI_OurDeliveryTime' datatype='real' name='[Calculation_0286149179154454]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([EstimatedDeliveryMinutes])' />
      </column>
      <column caption='PlatformCount' datatype='integer' name='[Calculation_0286149183827991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LEN( [PlatformsUsed] ) - LEN(REPLACE( [PlatformsUsed] , &apos;,&apos; , &apos;&apos; ) ) + 1' />
      </column>
      <column caption='RatingScore' datatype='real' name='[Calculation_0286149187149848]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GoogleMapsRating] / 5 * 100' />
      </column>
      <column caption='SpeedScore' datatype='real' name='[Calculation_0286149187305497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(1-([AverageDeliveryMinutes]-30) / 30) *100' />
      </column>
      <column caption='PriceScore' datatype='real' name='[Calculation_0286149187690522]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - ABS([Calculation_0286149148278798])' />
      </column>
      <column caption='PlatformScore' datatype='real' name='[Calculation_0286149187964955]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0286149183827991] / 5 * 100' />
      </column>
      <column caption='VulnerabilityScore' datatype='real' name='[Calculation_0286149188149276]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - ([Calculation_0286149148991503]/10)' />
      </column>
      <column caption='RiskLevel' datatype='string' name='[Calculation_0286149198430238]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([PriceDiff_Pct]) &lt; -10 THEN &quot;High Risk&quot; &#13;&#10;ELSEIF AVG([PriceDiff_Pct]) &lt; 0 THEN &quot;Medium Risk&quot;&#13;&#10;ELSE &quot;Low Risk&quot;&#13;&#10;END' />
      </column>
      <column caption='Category ID' datatype='integer' name='[CategoryID]' role='dimension' type='ordinal' />
      <column caption='CategoryName AR' datatype='string' name='[CategoryName_AR]' role='dimension' type='nominal' />
      <column caption='CategoryName EN' datatype='string' name='[CategoryName_EN]' role='dimension' type='nominal' />
